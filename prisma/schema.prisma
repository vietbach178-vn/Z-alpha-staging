// Z-Alpha — content + admin schema.
// Run after editing: npx prisma migrate dev --name <description>
// Prisma 7 emits the client to ../src/generated/prisma — import from @/generated/prisma.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// AUTH
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// RESEARCH
// ---------------------------------------------------------------------------
model ResearchArticle {
  id          String        @id @default(cuid())
  slug        String        @unique
  titleVi     String
  titleEn     String?
  excerptVi   String?
  excerptEn   String?
  bodyVi      Json          @default("[]") // BlockNote document JSON
  bodyEn      Json?
  heroImage   String? // Supabase storage public URL
  topicId     String?
  topic       Topic?        @relation(fields: [topicId], references: [id])
  tags        Tag[]
  authorId    String?
  author      Author?       @relation(fields: [authorId], references: [id])
  attachments ResearchAttachment[]
  readingTime Int?
  typeVi      String? // "Thực nghiệm", "Báo cáo", ...
  typeEn      String?
  featured    Boolean       @default(false)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  seoTitleVi  String?
  seoTitleEn  String?
  seoDescVi   String?
  seoDescEn   String?
  seoOgImage  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([topicId])
}

enum AttachmentLanguage {
  VI
  EN
  OTHER
}

enum LibraryCategory {
  BOOK
  REPORT
  REFERENCE
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum ContactAudience {
  STUDENT       // Học sinh, sinh viên
  SCHOOL        // Nhà trường / cơ sở giáo dục
  GOVERNMENT    // Chính phủ / nhà hoạch định chính sách
  OTHER         // Khác
}

model ContactSubmission {
  id          String          @id @default(cuid())
  fullName    String
  email       String
  audience    ContactAudience @default(OTHER)
  message     String
  isUrgent    Boolean         @default(false)
  status      ContactStatus   @default(NEW)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
}

model LibraryItem {
  id            String          @id @default(cuid())
  slug          String          @unique
  titleVi       String
  titleEn       String?
  descriptionVi String?
  descriptionEn String?
  thumbnailUrl  String?         // Optional cover image (Vercel Blob)
  fileUrl       String          // Primary downloadable file
  fileName      String          // Original filename for download attribute
  fileSize      Int?            // bytes
  fileMime      String?
  category      LibraryCategory @default(REPORT)
  status        ContentStatus   @default(DRAFT)
  publishedAt   DateTime?
  order         Int             @default(0)
  seoTitleVi    String?
  seoTitleEn    String?
  seoDescVi     String?
  seoDescEn     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model ResearchAttachment {
  id        String              @id @default(cuid())
  articleId String
  article   ResearchArticle     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fileUrl   String              // Vercel Blob public URL
  fileName  String              // original filename for download
  fileSize  Int?                // bytes
  fileMime  String?             // e.g. "application/pdf"
  language  AttachmentLanguage  @default(VI)
  labelVi   String?             // optional display label override (VI)
  labelEn   String?             // optional display label override (EN)
  order     Int                 @default(0)
  createdAt DateTime            @default(now())

  @@index([articleId, order])
}

model Topic {
  id       String            @id @default(cuid())
  slug     String            @unique
  labelVi  String
  labelEn  String?
  tone     String            @default("blue") // teal | blue | orange | red | purple
  order    Int               @default(0)
  articles ResearchArticle[]
}

// ---------------------------------------------------------------------------
// NEWS
// ---------------------------------------------------------------------------
model NewsItem {
  id          String        @id @default(cuid())
  slug        String        @unique
  titleVi     String
  titleEn     String?
  excerptVi   String?
  excerptEn   String?
  bodyVi      Json          @default("[]")
  bodyEn      Json?
  heroImage   String?
  categoryId  String?
  category    NewsCategory? @relation(fields: [categoryId], references: [id])
  source      String? // "Báo Tuổi Trẻ" etc.
  externalUrl String? // when card links out
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  seoTitleVi  String?
  seoTitleEn  String?
  seoDescVi   String?
  seoDescEn   String?
  seoOgImage  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model NewsCategory {
  id      String     @id @default(cuid())
  slug    String     @unique
  labelVi String
  labelEn String?
  tone    String     @default("blue")
  order   Int        @default(0)
  items   NewsItem[]
}

// ---------------------------------------------------------------------------
// TEAM
// ---------------------------------------------------------------------------
model TeamMember {
  id        String   @id @default(cuid())
  fullName  String
  initials  String?
  roleVi    String?
  roleEn    String?
  bioVi     String?
  bioEn     String?
  avatar    String?
  group     String? // 'researcher' | 'youngResearcher'
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// AUTHOR + TAG
// ---------------------------------------------------------------------------
model Author {
  id       String            @id @default(cuid())
  name     String
  avatar   String?
  bioVi    String?
  bioEn    String?
  articles ResearchArticle[]
}

model Tag {
  id       String            @id @default(cuid())
  slug     String            @unique
  labelVi  String
  labelEn  String?
  articles ResearchArticle[]
}

// ---------------------------------------------------------------------------
// MEDIA ASSETS (image/video/pdf uploaded via admin)
// ---------------------------------------------------------------------------
model Asset {
  id         String   @id @default(cuid())
  url        String // Supabase storage public URL
  type       String // image | video | pdf
  filename   String
  sizeBytes  Int
  width      Int?
  height     Int?
  alt        String?
  uploadedAt DateTime @default(now())

  @@index([type])
}
